// Cloudflare deployment config for the Kickstat frontend.
// Deploys the production Vite build (frontend/dist) as static assets.
// "single-page-application" fallback serves index.html for unknown routes,
// matching the SPA routing previously handled by public/_redirects.
{
  "name": "kickstat",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
